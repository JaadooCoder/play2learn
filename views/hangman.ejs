<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hangman Coding Game</title>
  <style>
    body {
      background: #1e1e2f;
      color: #fff;
      font-family: 'Poppins', sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      margin: 0;
    }
    h1 {
      margin-bottom: 10px;
    }
    #difficulty {
      margin-bottom: 20px;
    }
    #letters, #word {
      display: none;
    }
    #message {
      margin-top: 20px;
      font-size: 1.2rem;
      color: #f39c12;
    }
    #hangman-visual {
      font-size: 2rem;
      line-height: 2rem;
      margin-bottom: 20px;
      white-space: pre;
      font-family: monospace;
    }
    #mcq-section {
      margin-top: 30px;
      max-width: 500px;
      text-align: center;
    }
    .mcq-option {
      display: block;
      margin: 10px 0;
      padding: 10px;
      background: #34495e;
      border-radius: 8px;
      cursor: pointer;
    }
    .mcq-option:hover {
      background: #3e5870;
    }
  </style>
</head>
<body>
  <h1>Hangman: Solve Coding MCQs to Survive</h1>
  <div id="hangman-visual"></div>
  <div id="message"></div>
  <div id="mcq-section">
    <h3 id="mcq-question"></h3>
    <div id="mcq-options"></div>
  </div>

  <script>
    const mcqBank = {
      easy: [
        {
          question: "What does HTML stand for?",
          options: ["Hyper Text Markup Language", "Home Tool Markup Language", "Hyperlinks and Text Markup Language", "Hyperlinking Text Management Language"],
          answer: "Hyper Text Markup Language"
        },
        {
          question: "Which language is used for styling web pages?",
          options: ["HTML", "JQuery", "CSS", "XML"],
          answer: "CSS"
        },
        {
          question: "What is the correct file extension for Python files?",
          options: [".py", ".pt", ".pyt", ".p"],
          answer: ".py"
        },
        {
          question: "How do you print something in Python?",
          options: ["echo", "print()", "printf()", "console.log()"],
          answer: "print()"
        },
        {
          question: "Which data type is used to store text?",
          options: ["int", "str", "bool", "float"],
          answer: "str"
        },
        {
          question: "What symbol is used to comment a single line in Python?",
          options: ["//", "#", "/*", "<!--"],
          answer: "#"
        },
        {
          question: "Which keyword is used to define a function in Python?",
          options: ["function", "def", "fun", "define"],
          answer: "def"
        },
        {
          question: "Which operator is used for exponentiation in Python?",
          options: ["^", "**", "exp()", "//"],
          answer: "**"
        },
        {
          question: "How do you start a for loop in Python?",
          options: ["loop x in y", "foreach x in y", "for x in y:", "for (x in y)"],
          answer: "for x in y:"
        },
        {
          question: "What is the correct way to create a list?",
          options: ["{}", "()", "[]", "<>"],
          answer: "[]"
        },
        {
          question: "Which keyword is used to handle exceptions?",
          options: ["except", "error", "catch", "throw"],
          answer: "except"
        },
        {
          question: "How do you check the type of a variable?",
          options: ["typeof()", "checkType()", "type()", "varType()"],
          answer: "type()"
        }
      ],
      medium: [
        {
          question: "Which company developed JavaScript?",
          options: ["Netscape", "Microsoft", "Sun Microsystems", "Oracle"],
          answer: "Netscape"
        },
        {
          question: "What is a closure in JavaScript?",
          options: ["A function inside another function", "A deprecated feature", "A CSS technique", "A memory leak"],
          answer: "A function inside another function"
        }
      ],
      hard: [
        {
          question: "What is polymorphism in programming?",
          options: ["Ability to take multiple forms", "Memory leak", "Recursive function", "Data hiding"],
          answer: "Ability to take multiple forms"
        },
        {
          question: "What is the output of 'typeof NaN' in JavaScript?",
          options: ["number", "NaN", "undefined", "object"],
          answer: "number"
        }
      ]
    };

    const hangmanStages = [
      ` +---+\n |   |\n O   |\n/|\  |\n/ \  |\n     |\n=======`,
      ` +---+\n |   |\n O   |\n/|\  |\n/    |\n     |\n=======`,
      ` +---+\n |   |\n O   |\n/|\  |\n     |\n     |\n=======`,
      ` +---+\n |   |\n O   |\n/|   |\n     |\n     |\n=======`,
      ` +---+\n |   |\n O   |\n |   |\n     |\n     |\n=======`,
      ` +---+\n |   |\n O   |\n     |\n     |\n     |\n=======`,
      ` +---+\n |   |\n     |\n     |\n     |\n     |\n=======`
    ];

    let tries = 6;
    const hangmanVisualEl = document.getElementById("hangman-visual");
    const messageEl = document.getElementById("message");
    const mcqSection = document.getElementById("mcq-section");
    const mcqQuestion = document.getElementById("mcq-question");
    const mcqOptions = document.getElementById("mcq-options");

    function initGame() {
      tries = 6;
      messageEl.textContent = "";
      hangmanVisualEl.textContent = hangmanStages[tries];
      showMCQ('easy'); // Default difficulty level set to "easy"
    }

    function showMCQ(level) {
      const bank = mcqBank[level];
      const randomIndex = Math.floor(Math.random() * bank.length);
      const question = bank[randomIndex];

      mcqQuestion.textContent = question.question;
      mcqOptions.innerHTML = "";
      mcqSection.style.display = "block";

      question.options.forEach(opt => {
        const div = document.createElement("div");
        div.textContent = opt;
        div.classList.add("mcq-option");
        div.addEventListener("click", () => {
          if (opt === question.answer) {
            messageEl.textContent = "✅ Correct answer!";
          } else {
            tries--;
            messageEl.textContent = `❌ Incorrect! Tries left: ${tries}`;
            hangmanVisualEl.textContent = hangmanStages[tries];
          }
          if (tries > 0) setTimeout(() => showMCQ(level), 1500);
          else {
            messageEl.textContent = "💀 Game over!";
            mcqSection.style.display = "none";
          }
        });
        mcqOptions.appendChild(div);
      });
    }

    window.onload = initGame;
  </script>
</body>

</html>