<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Help Widget (Dark Mode)</title>
  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      background: #000;
      color: #fff;
      padding: 2rem;
    }

    /* Floating Help Button */
    #help-button {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: #fff;
      color: #000;
      border: none;
      border-radius: 50%;
      width: 60px;
      height: 60px;
      font-size: 24px;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(255, 255, 255, 0.2);
      transition: background 0.3s, color 0.3s;
    }

    #help-button:hover {
      background: #ccc;
      color: #000;
    }

    /* Help Box */
    #help-box {
      position: fixed;
      bottom: 90px;
      right: 20px;
      background: #111;
      border: 1px solid #444;
      border-radius: 12px;
      padding: 1.5rem;
      width: 300px;
      box-shadow: 0 0 15px rgba(255, 255, 255, 0.1);
      display: none;
      z-index: 999;
    }

    #help-box h3 {
      margin-top: 0;
      color: #fff;
    }

    .faq {
      margin-bottom: 1rem;
    }

    .faq p {
      margin: 0.25rem 0;
      font-size: 14px;
      color: #ccc;
    }

    #close-help {
      background: transparent;
      border: none;
      float: right;
      font-size: 18px;
      color: #fff;
      cursor: pointer;
    }

    #contact-btn {
      background: #fff;
      color: #000;
      border: none;
      padding: 0.5rem 1rem;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 1rem;
      transition: background 0.3s;
    }

    #contact-btn:hover {
      background: #ccc;
    }
  </style>
</head>
<body>

  <!-- Help Box -->
  <div id="help-box">
    <button id="close-help">&times;</button>
    <h3>Need Help?</h3>
    <div class="faq">
      <strong>Q: How do I subscribe?</strong>
      <p>A: Click on any plan and follow the instructions.</p>
    </div>
    <div class="faq">
      <strong>Q: Can I cancel anytime?</strong>
      <p>A: Yes, you can cancel from your account settings.</p>
    </div>
    <button id="contact-btn">Contact Support</button>
  </div>

  <!-- Floating Help Button -->
  <button id="help-button">❓</button>

  <script>
    const helpBtn = document.getElementById('help-button');
    const helpBox = document.getElementById('help-box');
    const closeHelp = document.getElementById('close-help');

    helpBtn.addEventListener('click', () => {
      helpBox.style.display = 'block';
    });

    closeHelp.addEventListener('click', () => {
      helpBox.style.display = 'none';
    });
  </script>
</body>
</html>
